# ============================================================
# LicenseServer backend environment variables
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ============================================================

# --- core ---
APP_NAME=LicenseServer
# development | production  (production disables /docs and enables HSTS)
ENVIRONMENT=development

# !!! CRITICAL !!! 32+ random chars. Signs admin JWTs, peppers HWID hashes.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-please-use-a-long-random-string

# --- database ---
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./license.db
# Postgres (production — survives restarts). auto-detects asyncpg + sslmode:
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# --- tokens ---
ADMIN_ACCESS_MINUTES=15
ADMIN_REFRESH_DAYS=30
SESSION_HOURS=24

# --- client auth ---
MAX_ACTIVATIONS_PER_LICENSE=1

# --- admin bootstrap (first run only) ---
# Change ADMIN_PASSWORD before going to production (the app refuses to boot
# with the default password in production).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-1234567890!

# --- CORS / cookies ---
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
COOKIE_SECURE=false   # MUST be true in production (HTTPS)
